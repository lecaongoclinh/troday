{
  "name": "troday-native",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node scripts/start.cjs",
    "dev": "node scripts/start.cjs",
    "android": "node scripts/start.cjs --android",
    "ios": "expo start --ios --port 8082",
    "web": "node scripts/start.cjs --web",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test --test-isolation=none tests/*.test.ts",
    "build:web": "expo export --platform web --max-workers 2",
    "build:native": "expo export --platform android --platform ios --output-dir dist-native --max-workers 2",
    "preview": "node scripts/preview.cjs",
    "format": "prettier --write App.tsx index.ts src tests scripts *.json *.js *.md docs/*.md",
    "test:browser": "node scripts/browser-check.cjs",
    "test:api-browser": "node scripts/browser-check.cjs --api",
    "check:reference": "node scripts/check-reference.cjs"
  },
  "dependencies": {
    "@expo-google-fonts/be-vietnam-pro": "^0.4.1",
    "@expo/vector-icons": "^15.0.2",
    "@react-navigation/native": "^7.1.0",
    "@react-navigation/native-stack": "^7.3.0",
    "expo": "~58.0.20",
    "expo-crypto": "~58.0.0",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.12",
    "expo-font": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-sharing": "~58.0.20",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@expo/ngrok": "4.1.3",
    "@types/node": "^24.0.0",
    "@types/react": "~19.2.2",
    "prettier": "^3.6.2",
    "typescript": "~5.9.2"
  }
}
