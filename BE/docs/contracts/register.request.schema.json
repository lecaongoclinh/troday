{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RegisterRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["fullName", "password"],
  "anyOf": [{"required": ["email"], "properties": {"email": {"type": "string", "pattern": "\\S"}}}, {"required": ["phoneNumber"], "properties": {"phoneNumber": {"type": "string", "pattern": "\\S"}}}],
  "properties": {
    "fullName": {"type": "string", "minLength": 1, "maxLength": 150, "pattern": "\\S"},
    "email": {"type": ["string", "null"], "maxLength": 150},
    "phoneNumber": {"type": ["string", "null"], "maxLength": 40},
    "password": {"type": "string", "minLength": 10, "maxLength": 72, "description": "Server additionally enforces at most 72 UTF-8 bytes."}
  }
}
