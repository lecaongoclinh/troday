# Backend server
PORT=8081

# MySQL connection: replace with your local credentials
DB_URL=jdbc:mysql://localhost:3306/troday?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Ho_Chi_Minh
DB_USERNAME=root
DB_PASSWORD=change-me
# Kho tệp local và khóa ký URL; dùng cùng khóa trên các instance khi triển khai.
FILE_STORAGE_ROOT=uploads
FILE_SIGNING_SECRET=

# Dịch vụ gửi mã: HTTP POST {userId,target,purpose,code}; không trả mã OTP qua API.
VERIFICATION_DELIVERY_URL=
VERIFICATION_DELIVERY_TOKEN=
# Chỉ dùng local khi phát triển; để trống ở production.
VERIFICATION_LOCAL_INBOX=

# Các user ID chủ trọ được cấp riêng quyền nhập hợp đồng giấy, cách nhau bằng dấu phẩy.
PAPER_IMPORT_USER_IDS=
BACKGROUND_JOBS_ENABLED=true
