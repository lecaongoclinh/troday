# Generate deploy/.env with: python3 deploy/configure.py --domain YOUR-NAME.duckdns.org
# Do not put https:// or /api/v1 in APP_DOMAIN.
APP_DOMAIN=YOUR-NAME.duckdns.org
MYSQL_ROOT_PASSWORD=GENERATE_A_RANDOM_ROOT_PASSWORD
MYSQL_PASSWORD=GENERATE_A_DIFFERENT_RANDOM_APP_PASSWORD
FILE_SIGNING_SECRET=GENERATE_A_RANDOM_STABLE_SIGNING_SECRET
PAPER_IMPORT_USER_IDS=
# Optional HTTPS webhook for OTP delivery. Leave blank until a provider is ready.
VERIFICATION_DELIVERY_URL=
VERIFICATION_DELIVERY_TOKEN=
