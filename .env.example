# Local development only. Copy to .env; do not commit .env.
COMPOSE_PROJECT_NAME=troday
API_PORT=8081
WEB_PORT=5173
MYSQL_USER=troday
MYSQL_PASSWORD=troday_local_password
MYSQL_ROOT_PASSWORD=troday_local_root_password
# Optional for mobile on a physical phone if automatic LAN detection is wrong:
# LAN_IP=192.168.1.10
# Optional when using an API hosted elsewhere (must include /api/v1):
# EXPO_PUBLIC_API_BASE_URL=https://api.example.com/api/v1
